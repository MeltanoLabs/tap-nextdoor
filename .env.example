# tap-nextdoor configuration
#
# Copy this file to .env and fill in your values. .env is gitignored.
# Settings map to env vars as TAP_NEXTDOOR_<SETTING_NAME_UPPERCASED>.
#
# Read by:
#   - Meltano: picked up automatically (`meltano run tap-nextdoor target-jsonl`)
#   - the tap directly: only with `--config=ENV`, e.g.
#       uv run tap-nextdoor --config=ENV --discover > catalog.json

# Required: Ads API access token, generated in Nextdoor Ads Manager at
# https://ads.nextdoor.com/v2/manage/api.
TAP_NEXTDOOR_ACCESS_TOKEN=your_access_token_here

# Optional: restrict to specific advertisers. Must be a JSON array of strings
# (a bare comma-separated list still works but is deprecated in the SDK).
# TAP_NEXTDOOR_ADVERTISER_IDS=["123456","789012"]

# --- Ad performance report (performance_report stream) -------------------
# Object settings are parsed as JSON, so this must stay on ONE line.
# Supported values:
#   metrics               IMPRESSIONS, CLICKS, CTR, SPEND, BILLABLE_SPEND, CPM, CPC, CPA,
#                         CONVERSIONS, RESULT, COST_PER_RESULT, LEAD_GEN_FORM_*, VIDEO_FORMAT_*
#   dimension_granularity CAMPAIGN, CAMPAIGN_ID, AD_GROUP, AD_GROUP_ID, AD, AD_ID,
#                         PLATFORM_TYPE, PLACEMENT
#   time_granularity      DAY, WEEK, MONTH
# Optional filters: campaign_ids, adgroup_ids, ad_ids.
# The stream (and so the target table) is named after `name`, slugified:
# "Ad Performance Report" -> ad_performance_report. Override with stream_name.
#
# WARNING: this stream WRITES. Every sync creates a report in the advertiser's
# account and emails everyone in recipient_emails. An empty list emails nobody.
# TAP_NEXTDOOR_REPORT='{"metrics": ["IMPRESSIONS", "CLICKS", "CTR", "SPEND", "BILLABLE_SPEND", "CPM", "CPC", "CPA", "CONVERSIONS", "RESULT", "COST_PER_RESULT"], "dimension_granularity": ["AD_ID", "AD"], "time_granularity": ["DAY"], "name": "Ad Performance Report", "recipient_emails": []}'

# The report window comes from these top-level settings, not from the report
# object. Both are LocalDates; end_date is inclusive and defaults to today.
# TAP_NEXTDOOR_START_DATE=2026-07-01
# TAP_NEXTDOOR_END_DATE=2026-07-31
